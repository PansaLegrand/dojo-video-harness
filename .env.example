# Keys stay in this local Node process. No key is sent to the browser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# OpenAI-compatible transcription endpoints; whisper-1 supplies word timestamps.
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_API_KEY=
PORT=4310
DATA_DIR=.data
