# GPT-only chat and caption translation use the Responses API.
# Optional advanced defaults. In-app Provider settings override these values.
# Saved keys are never returned to the browser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-sol
# For Kie, set LLM_BASE_URL=https://api.kie.ai/codex/v1 and use your Kie key.
LLM_API_KEY=
# Explicit Vercel Gateway alternative (same GPT family):
# LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM_MODEL=openai/gpt-6-sol (use your own Gateway key in LLM_API_KEY)
# OpenAI-compatible transcription endpoints; whisper-1 supplies word timestamps.
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_API_KEY=
# ElevenLabs alternative: ASR_BASE_URL=https://api.elevenlabs.io/v1
# ASR_MODEL=scribe_v1 (use your own ElevenLabs key in ASR_API_KEY)
PORT=4310
DATA_DIR=.data

# Optional instrumental background music. No public callback server is required.
MUSIC_BASE_URL=https://api.kie.ai
MUSIC_MODEL=V6
MUSIC_API_KEY=
# Optional directory of trusted local .md instructions (default: ./skills).
# SKILLS_DIR=./skills
