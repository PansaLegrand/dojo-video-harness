# GPT-only chat and caption translation use the Responses API.
# Optional advanced defaults. In-app Provider settings override these values.
# Saved keys are never returned to the browser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-sol
# For Kie, set LLM_BASE_URL=https://api.kie.ai/codex/v1 and use your Kie key.
LLM_API_KEY=
# OpenAI-compatible transcription endpoints; whisper-1 supplies word timestamps.
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_API_KEY=
# ElevenLabs alternative: ASR_BASE_URL=https://api.elevenlabs.io/v1
# ASR_MODEL=scribe_v1 (use your own ElevenLabs key in ASR_API_KEY)
PORT=4310
DATA_DIR=.data
