{
  "name": "dojo-video-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env apps/server/src/main.ts",
    "start": "tsx --env-file-if-exists=.env apps/server/src/main.ts --production",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "format": "prettier --write packages/agent packages/adapters apps tests scripts/*.mjs docs README.md"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "1.50.3",
    "@radix-ui/react-select": "2.2.4",
    "@radix-ui/react-slot": "1.2.2",
    "bidi-js": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-sha256": "1.3.0",
    "lottie-web": "5.13.0",
    "lucide-react": "0.469.0",
    "mediabunny": "1.50.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "esbuild": "0.28.1",
    "playwright": "1.60.0",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
