{
  "name": "dojo-video-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "start": "node scripts/run-next.mjs start",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:agent-kit && npm run check:ui-sync && npm run typecheck && npm test && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "format": "prettier --write packages/agent packages/adapters packages/ui/src/host apps/server tests scripts config/aliases.ts README.md docs/*.md",
    "check:ui-sync": "node scripts/sync-product-ui.mjs --verify",
    "sync:ui": "node scripts/sync-product-ui.mjs",
    "test:ui-parity": "node scripts/verify-product-ui.mjs",
    "test:live:gpt": "tsx scripts/test-live-gpt.ts",
    "test:live:asr": "tsx scripts/test-live-asr.ts",
    "test:agent:scenarios": "vitest run tests/agent-scenarios.test.ts tests/agent-service.test.ts tests/agent.test.ts tests/gpt-responses.test.ts tests/atomic-replace.test.ts tests/provider-settings.test.ts tests/store.test.ts tests/agent-process-recovery.test.ts tests/evaluation-oracles.test.ts tests/evaluation-evidence.test.ts tests/extended-agent-scenarios.test.ts tests/elevenlabs-asr.test.ts tests/editing-workflow.test.ts tests/basic-speech-editing.test.ts tests/music-service.test.ts tests/music-adapter.test.ts tests/skill-loader.test.ts",
    "eval:agent": "tsx scripts/evaluate-agent.ts",
    "verify:milestone": "node scripts/verify-milestone.mjs",
    "setup": "node scripts/setup.mjs",
    "launch": "node scripts/setup.mjs --start",
    "doctor": "node scripts/doctor.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "test:engine-packages": "node scripts/test-engine-packages.mjs",
    "test:live:music": "tsx scripts/test-live-music.ts",
    "eval:basic:planner": "tsx scripts/evaluate-basic-workflow-planner.ts",
    "eval:speech:semantics": "tsx scripts/evaluate-speech-semantics.ts",
    "check:agent-kit": "npm run check:skills --workspace @dojo-video/agent-kit && npm run build --workspace @dojo-video/agent-kit"
  },
  "dependencies": {
    "@dojo-video-engine/agent-tools": "1.2.1",
    "@dojo-video-engine/core": "1.2.1",
    "@dojo-video-engine/export": "1.2.1",
    "@dojo-video-engine/interchange": "1.2.1",
    "@dojo-video-engine/player": "1.2.1",
    "@dojo-video-engine/presets": "1.2.1",
    "@dojo-video-engine/renderer-canvas2d": "1.2.1",
    "@dojo-video-engine/schema": "1.2.1",
    "@dojo-video-engine/three": "1.2.1",
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@mediabunny/mp3-encoder": "1.50.3",
    "@radix-ui/react-select": "2.2.4",
    "@radix-ui/react-slot": "1.2.2",
    "@tailwindcss/typography": "0.5.16",
    "bidi-js": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-sha256": "1.3.0",
    "lottie-web": "5.13.0",
    "lucide-react": "0.469.0",
    "mediabunny": "1.50.3",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "esbuild": "0.28.1",
    "playwright": "1.60.0",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PansaLegrand/dojo-video-harness.git"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-harness#readme",
  "bugs": {
    "url": "https://github.com/PansaLegrand/dojo-video-harness/issues"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5",
    "postcss": "8.5.32"
  }
}
