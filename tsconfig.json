{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": [
      "node"
    ],
    "paths": {
      "@/lib/*": [
        "packages/core/src/lib/*"
      ],
      "@/types/*": [
        "packages/core/src/types/*"
      ],
      "@/components/*": [
        "packages/ui/src/components/*"
      ],
      "@/contexts/*": [
        "packages/ui/src/contexts/*"
      ],
      "@/host/*": [
        "packages/ui/src/host/*"
      ],
      "@/components/editor/dojo-video-engine/dojo-video-engine-editor": [
        "packages/ui/src/host/harness-editor.tsx"
      ]
    },
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    "packages",
    "apps/server",
    "tests",
    "config",
    "vitest.config.ts",
    "scripts/test-live-gpt.ts",
    "evals/**/*.ts",
    "scripts/evaluate-agent.ts",
    "scripts/test-live-music.ts",
    "scripts/evaluate-basic-workflow-planner.ts",
    "scripts/evaluate-speech-semantics.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
