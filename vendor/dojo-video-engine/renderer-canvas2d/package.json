{
  "name": "@dojo-video-engine/renderer-canvas2d",
  "version": "1.1.0",
  "description": "Deterministic Canvas2D still-frame renderer for dojo-video-engine scenes.",
  "keywords": [
    "dojo-video-engine",
    "video",
    "canvas",
    "canvas2d",
    "renderer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/dojo-video-engine.git",
    "directory": "packages/renderer-canvas2d"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-engine#readme",
  "bugs": "https://github.com/PansaLegrand/dojo-video-engine/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dojo-video-engine/core": "workspace:*",
    "@dojo-video-engine/extensions": "workspace:*",
    "@dojo-video-engine/runtime": "workspace:*",
    "@dojo-video-engine/schema": "workspace:*",
    "mediabunny": "^1.46.0"
  },
  "devDependencies": {
    "lottie-web": "^5.13.0",
    "vitest": "^3.2.7",
    "zod": "^3.25.67"
  },
  "peerDependencies": {
    "lottie-web": "^5.12.0"
  },
  "peerDependenciesMeta": {
    "lottie-web": {
      "optional": true
    }
  }
}
