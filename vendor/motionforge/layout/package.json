{
  "name": "@motionforge/layout",
  "version": "1.1.0",
  "description": "Bounded semantic layout authoring that compiles to MotionForge Scene v1.",
  "keywords": [
    "motionforge",
    "video",
    "layout",
    "grid",
    "stack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/motionforge.git",
    "directory": "packages/layout"
  },
  "homepage": "https://github.com/PansaLegrand/motionforge#readme",
  "bugs": "https://github.com/PansaLegrand/motionforge/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@motionforge/core": "workspace:*",
    "@motionforge/schema": "workspace:*",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "^3.2.7"
  }
}
